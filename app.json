{
  "expo": {
    "name": "Pace & Progress",
    "slug": "pace-and-progress",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/android/play_store_512.png",
    "scheme": "paceandprogress",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.parcial.paceandprogress",
      "icon": "./assets/images/ios/AppIcon.png"
    },
    "android": {
      "package": "com.parcial.paceandprogress",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android/res/mipmap-xxxhdpi/ic_launcher_foreground.png",
        "backgroundImage": "./assets/images/android/res/mipmap-xxxhdpi/ic_launcher_background.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/android/play_store_512.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/android/play_store_512.png",
          "imageWidth": 200,
          "backgroundColor": "#ffffff",
          "resizeMode": "contain"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cc5e3d14-78ae-462f-836b-afddc94cac8c"
      }
    }
  }
}
